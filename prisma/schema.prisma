generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  FREE
  PRO
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ExternalPlatform {
  AMAZON
  WALMART
  SHOPIFY
  OTHER
}

enum RecipientKind {
  CONTACT
  INLINE_EMAIL
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  hashedPassword           String?
  name                     String?
  tier                     Tier      @default(FREE)
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeCurrentPeriodEnd   DateTime?
  stripeSubscriptionStatus String?
  emailVerifiedAt          DateTime?
  sessionVersion           Int       @default(1)
  checkoutAttemptId        String?
  checkoutAttemptExpires   DateTime?
  passwordResetToken       String?
  passwordResetExpiry      DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  items             InventoryItem[]
  contacts          AlertContact[]
  pushSubscriptions PushSubscription[]
  authIdentities    AuthIdentity[]
  storedImages      StoredImage[]
  recipientConsents RecipientConsent[]
}

model AuthIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InventoryItem {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  imageUrl            String?
  alertEmail          String
  alertEmailEnabled   Boolean   @default(true)
  scanCooldownMinutes Int       @default(60)
  scanAcknowledgement String?
  lastAlertAt         DateTime?
  qrCodeId            String    @unique @default(uuid())
  userId              String

  lowStockThreshold Int?
  labelLayout       Json?

  // Future: third-party shopping cart integration
  externalCartLink  String?
  externalPlatform  ExternalPlatform?
  externalApiKeyRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRecipients  InventoryItemRecipient[]
  stockingRequests StockingRequest[]

  @@index([userId])
  @@index([qrCodeId])
}

model AlertContact {
  id              String   @id @default(cuid())
  userId          String
  name            String
  email           String
  emailNormalized String
  cellPhone       String?
  emailEnabled    Boolean  @default(true)
  smsOptIn        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemRecipients InventoryItemRecipient[]

  @@unique([userId, emailNormalized])
  @@index([userId])
}

model InventoryItemRecipient {
  id                    String        @id @default(cuid())
  itemId                String
  kind                  RecipientKind
  contactId             String?
  inlineEmail           String?
  inlineEmailNormalized String?
  position              Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  contact AlertContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([itemId, contactId])
  @@unique([itemId, inlineEmailNormalized])
  @@index([itemId])
  @@index([contactId])
}

// Fixed-window rate limit counters, keyed by "<scope>:<identifier>".
// DB-backed so limits hold across serverless instances. Old windows are
// cleaned up opportunistically by lib/rate-limit.ts.
model RateLimitWindow {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

model StockingRequest {
  id            String            @id @default(cuid())
  itemId        String
  status        RequestStatus     @default(PENDING)
  emailSent     Boolean           @default(false)
  submissionKey String?
  notifications NotificationJob[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, submissionKey])
  @@index([itemId, createdAt])
  @@index([itemId])
  @@index([createdAt])
  @@index([status])
}

model StoredImage {
  url       String   @id
  userId    String
  deleting  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecipientConsent {
  id          String    @id @default(cuid())
  userId      String
  email       String
  verifiedAt  DateTime?
  tokenHash   String?   @unique
  tokenExpiry DateTime?
  requestedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

enum NotificationKind {
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model NotificationJob {
  itemName      String
  id            String           @id @default(cuid())
  requestId     String
  kind          NotificationKind
  recipient     String
  status        DeliveryStatus   @default(PENDING)
  attempts      Int              @default(0)
  nextAttemptAt DateTime         @default(now())
  lockedUntil   DateTime?
  leaseToken    String?
  providerId    String?
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  request       StockingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind, recipient])
  @@index([status, nextAttemptAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
